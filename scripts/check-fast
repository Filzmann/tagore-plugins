#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

echo "=== Workspace structure ==="
./scripts/check-workspace-structure

echo
echo "=== Component repositories ==="
while IFS=$'\t' read -r path kind slug _runtime_link <&3; do
	[[ "$path" == "path" ]] && continue
	[[ "$kind" == "plugin" || "$kind" == "theme" ]] || continue
	echo
	echo "--- $slug ---"
	"$ROOT_DIR/$path/scripts/check-fast"
done 3< config/workspace-components.tsv

echo
echo "=== Diff hygiene ==="
git diff --check
echo "git diff --check: OK"

echo
echo "OK: fast workspace checks completed."
