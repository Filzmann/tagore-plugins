#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

echo "=== Workspace shell syntax ==="
while IFS= read -r script; do
	bash -n "$script"
done < <(
	find scripts tests \
		-path '*/vendor' -prune -o \
		-path '*/node_modules' -prune -o \
		-type f \( -name '*.sh' -o -name 'check-*' \) -print | sort
)
echo "Shell syntax: OK"

echo "=== Workspace structure ==="
./scripts/check-workspace-structure

echo
echo "=== Quality-gate contract ==="
bash tests/check-quality-gates.sh

echo
echo "=== CI contract ==="
bash tests/check-ci-contract.sh

echo
echo "=== Coverage tooling contract ==="
bash tests/check-coverage-contract.sh

echo
echo "=== Component repositories ==="
while IFS=$'\t' read -r path kind slug _runtime_link <&3; do
	[[ "$path" == "path" ]] && continue
	[[ "$kind" == "plugin" || "$kind" == "theme" ]] || continue
	echo
	echo "--- $slug ---"
	"$ROOT_DIR/$path/scripts/check-fast"
done 3< config/workspace-components.tsv

echo
echo "=== Diff hygiene ==="
git diff --check
echo "git diff --check: OK"

echo
echo "OK: fast workspace checks completed."
