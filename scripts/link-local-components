#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNTIME_CONTENT="$(cd "$ROOT_DIR/../tagore-local/public/wp-content" 2>/dev/null && pwd)" \
	|| { echo "ERROR: tagore-local wp-content not found." >&2; exit 1; }
APPLY=0

if [[ "${1:-}" == "--apply" ]]; then
	APPLY=1
elif [[ $# -gt 0 ]]; then
	echo "Usage: scripts/link-local-components [--apply]" >&2
	exit 2
fi

missing=0
while IFS=$'\t' read -r path kind slug runtime_link; do
	[[ "$path" == "path" ]] && continue
	[[ "$kind" == "plugin" || "$kind" == "theme" ]] || continue
	source_path="$ROOT_DIR/$path"
	target_path="$RUNTIME_CONTENT/$runtime_link"

	if [[ -L "$target_path" ]]; then
		actual="$(readlink -f "$target_path")"
		expected="$(readlink -f "$source_path")"
		[[ "$actual" == "$expected" ]] \
			|| { echo "ERROR: unexpected symlink: $target_path -> $actual" >&2; exit 1; }
		echo "OK: $runtime_link"
	elif [[ -e "$target_path" ]]; then
		echo "ERROR: refusing to replace non-symlink: $target_path" >&2
		exit 1
	elif [[ "$APPLY" -eq 1 ]]; then
		ln -s "$source_path" "$target_path"
		echo "LINKED: $runtime_link -> $source_path"
	else
		echo "MISSING: $runtime_link -> $source_path"
		missing=1
	fi
done < "$ROOT_DIR/config/workspace-components.tsv"

if [[ "$missing" -ne 0 ]]; then
	echo "Run with --apply only after explicit authorization." >&2
	exit 1
fi
